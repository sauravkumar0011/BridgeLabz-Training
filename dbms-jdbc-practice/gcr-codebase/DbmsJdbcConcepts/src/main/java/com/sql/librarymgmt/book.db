-- mysql>
SELECT * FROM book;

/* o/p
+---------+------------------------+-------------------+-----------+------------------+
| book_id | title                  | author            | genre     | copies_available |
+---------+------------------------+-------------------+-----------+------------------+
|       1 | Attack on Titans       | Hajime Isayama    | Action    |                5 |
